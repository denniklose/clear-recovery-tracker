# Public browser values only. Never put a Supabase service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
# Legacy name; use either this or the newer publishable key below.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# New Supabase projects may provide this instead of the anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Web Push: only the public VAPID key is exposed to the browser.
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=

# Server-only Web Push and anonymous device storage values.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:you@example.com
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
